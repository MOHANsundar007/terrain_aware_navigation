<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>terrain_nav_navigation</name>
  <version>0.1.0</version>
  <description>Nav2 configurations (default 2D vs terrain-aware) and full-stack bringup launch.</description>
  <maintainer email="gmohanasundaram17@gmail.com">Mohan</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_regulated_pure_pursuit_controller</exec_depend>
  <exec_depend>nav2_navfn_planner</exec_depend>
  <exec_depend>terrain_costmap_plugin</exec_depend>
  <exec_depend>terrain_nav_gazebo</exec_depend>
  <exec_depend>terrain_nav_localization</exec_depend>
  <exec_depend>terrain_nav_mapping</exec_depend>
  <exec_depend>grid_map_rviz_plugin</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
