<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="chassis_length" value="0.80"/>
  <xacro:property name="chassis_width"  value="0.50"/>
  <xacro:property name="chassis_height" value="0.18"/>
  <xacro:property name="chassis_mass"   value="20.0"/>
  <xacro:property name="chassis_z_offset" value="0.08"/>

  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="wheel_width"  value="0.10"/>
  <xacro:property name="wheel_mass"   value="1.5"/>
  <xacro:property name="wheel_x_offset" value="0.25"/>
  <xacro:property name="wheel_y_offset" value="${chassis_width / 2 + wheel_width / 2 + 0.02}"/>
  <xacro:property name="wheel_separation" value="${2 * wheel_y_offset}"/>

  <xacro:macro name="box_inertia" params="m x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m / 12.0 * (y*y + z*z)}" ixy="0" ixz="0"
               iyy="${m / 12.0 * (x*x + z*z)}" iyz="0"
               izz="${m / 12.0 * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${m}"/>
      <inertia ixx="${m / 12.0 * (3*r*r + h*h)}" ixy="0" ixz="0"
               iyy="${m / 12.0 * (3*r*r + h*h)}" iyz="0"
               izz="${m / 2.0 * r*r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sensor_inertia" params="m">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </xacro:macro>

  <material name="rover_orange"><color rgba="0.95 0.45 0.10 1.0"/></material>
  <material name="tyre_black"><color rgba="0.08 0.08 0.08 1.0"/></material>
  <material name="sensor_grey"><color rgba="0.30 0.30 0.32 1.0"/></material>

</robot>
