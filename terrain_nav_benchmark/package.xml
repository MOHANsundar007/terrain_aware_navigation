<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>terrain_nav_benchmark</name>
  <version>0.1.0</version>
  <description>Benchmark default Nav2 vs terrain-aware navigation: success rate, path length, time and max tilt.</description>
  <maintainer email="gmohanasundaram17@gmail.com">Mohan</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>terrain_nav_navigation</exec_depend>
  <exec_depend>terrain_nav_gazebo</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ffmpeg</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
